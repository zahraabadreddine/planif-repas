# Copier ce fichier en .env et remplir les valeurs. Ne jamais commiter .env.

# Adresse de connexion PostgreSQL
DATABASEURL=""

# Secret de signature des sessions (générer une longue chaîne aléatoire)
AUTHSECRET=""

# Clé de l'API Claude (serveur uniquement) : fournisseur prévu, utilisé dès qu'elle est renseignée
ANTHROPICAPIKEY=""

# Clé de l'API Groq, en secours : utilisée seulement si ANTHROPICAPIKEY est vide
GROQAPIKEY=""
# Modèle Groq (facultatif, openai/gpt-oss-120b par défaut)
GROQMODELE=""

# Nombre maximum de messages à l'agent par foyer et par jour
AIDAILYQUOTA=""

# Mots de passe des comptes de départ créés par le seed (8 à 72 caractères), développement uniquement
# Compte admin@umami.test
SEEDADMINPASSWORD=""
# Foyers de test et foyer de démonstration d'Aminata
SEEDDEMOPASSWORD=""
